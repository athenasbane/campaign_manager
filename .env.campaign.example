# Copy to .env.campaign, or run npm run setup:campaign to generate a local GM key.
# These values are server-side. Never prefix private credentials with REACT_APP_ or VITE_.
LUXTRIA_GM_TOKEN=
LUXTRIA_DB_PATH=.local/luxtria.sqlite
LUXTRIA_API_HOST=127.0.0.1
LUXTRIA_API_PORT=3001
LUXTRIA_API_URL=http://127.0.0.1:3001
LUXTRIA_VAULT_PATH=
# Falls back to the existing public Cognito IDs when configured in .env.
LUXTRIA_COGNITO_USER_POOL_ID=
LUXTRIA_COGNITO_CLIENT_ID=
LUXTRIA_GM_GROUP=luxtria-gm
# For a separate website origin, supply one exact origin; otherwise serve from the API host.
LUXTRIA_ALLOWED_ORIGIN=
